# SEO Configuration
NEXT_PUBLIC_SITE_URL=https://dementia-aide.vercel.app

# Analytics & Verification
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_VERIFICATION=your_google_verification_code_here

# Social Media
TWITTER_HANDLE=@DementiaAide
FACEBOOK_PAGE_URL=https://facebook.com/DementiaAide

# Optional: Additional tracking
MICROSOFT_CLARITY_ID=your_clarity_id
HOTJAR_ID=your_hotjar_id

# Amazon Integration (existing)
AMAZON_SPP_CLIENT_ID=your_client_id
AMAZON_SPP_SECRET_KEY=your_secret_key
AMAZON_SPP_REFRESH_TOKEN=your_refresh_token
AMAZON_ASSOCIATE_TAG=your_associate_tag

# YouTube API (existing) 
YOUTUBE_API_KEY_1=your_youtube_key_1
YOUTUBE_API_KEY_2=your_youtube_key_2
YOUTUBE_API_KEY_3=your_youtube_key_3
YOUTUBE_API_KEY_4=your_youtube_key_4
YOUTUBE_API_KEY_5=your_youtube_key_5

# Payment Processing (Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Shop Pay / Shopify Checkout
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token

# Optional: storefront variant IDs for Bear Hug sizes
NEXT_PUBLIC_SHOPIFY_BEAR_HUG_VARIANT_S=gid://shopify/ProductVariant/123
NEXT_PUBLIC_SHOPIFY_BEAR_HUG_VARIANT_M=gid://shopify/ProductVariant/124
NEXT_PUBLIC_SHOPIFY_BEAR_HUG_VARIANT_L=gid://shopify/ProductVariant/125
NEXT_PUBLIC_SHOPIFY_BEAR_HUG_VARIANT_XL=gid://shopify/ProductVariant/126
NEXT_PUBLIC_SHOPIFY_BEAR_HUG_VARIANT_2XL=gid://shopify/ProductVariant/127